# ------------------------------------------------------------------
# CONFIG CHO API CHATBOT / LLM (Cổng 8001)
# ------------------------------------------------------------------
ENV=development

# --- Database, VectorDB & Cache ---
# Chatbot vẫn cần connect CSDL để truy vấn cấu hình Slot, Lịch sử Chat và Qdrant
DATABASE_URL=postgresql+asyncpg://chatbot_user:chatbot_pass@postgres:5432/chatbot_db
REDIS_URL=redis://redis:6379
QDRANT_HOST=qdrant

# --- API Keys của LLM ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=...
